# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# APP_URL=

# EDITOR_PASSWORD: Optional password to gate editor actions and blog post generation. Defaults to "meridian" if not specified.
# EDITOR_PASSWORD=

# GITHUB_TOKEN: GitHub Personal Access Token (classic or fine-grained with 'Contents: Read and write' permission).
# Used for automatically mirroring and pushing newly generated/curated articles straight into your GitHub repository.
# GITHUB_TOKEN=

# GITHUB_REPO: The GitHub repository to synchronize with (defaults to 'LuuOW/Meridian-Research-Journal').
# GITHUB_REPO=LuuOW/Meridian-Research-Journal

# GITHUB_BRANCH: The branch to push updates to (defaults to 'main' if not set).
# GITHUB_BRANCH=main

# GITHUB_AUTHOR_NAME: Commit author name (defaults to 'Meridian Research').
# GITHUB_AUTHOR_NAME=Meridian Research

# GITHUB_AUTHOR_EMAIL: Commit author email (defaults to 'bot@ask-meridian.uk').
# GITHUB_AUTHOR_EMAIL=bot@ask-meridian.uk

# SMTP Email Configuration: Used by the Daily Research Journal Predictor to send daily options to your inbox.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# USER_EMAIL=
